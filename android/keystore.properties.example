# Copy this file to android/keystore.properties and fill in your own values.
# Never commit the real file or the .jks keystore -- losing them means you can
# no longer ship updates to the same Play Store listing.
#
# Create an upload keystore once with:
#   keytool -genkey -v -keystore macrotracker-upload.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias macrotracker
#
# storeFile is resolved relative to the android/ directory.
storeFile=macrotracker-upload.jks
storePassword=CHANGE_ME
keyAlias=macrotracker
keyPassword=CHANGE_ME
